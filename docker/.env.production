# =============================================================================
# MedTech 2.0 — PRODUCTION environment
#
# Generated 2026-07-31. Secrets below are freshly minted and have never
# been used locally or shown in a terminal session.
#
#   chmod 600 .env.production
#   cp .env.production .env      # on the server, then delete this file
#
# This file is gitignored (.env.* rule). Never commit it.
# =============================================================================

# ── Domain ───────────────────────────────────────────────────────────────────
# Must match nginx server_name and the Let's Encrypt certificate.
MEDTECH_FRONTEND_URL=https://CHANGE-ME.duckdns.org

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=medtech
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TGou6VDQfqFfnMLssAwzeNVtLyRO
MEDTECH_DB_URL=jdbc:postgresql://postgres:5432/medtech
MEDTECH_DB_USER=medtech_app
MEDTECH_DB_PASSWORD=TGou6VDQfqFfnMLssAwzeNVtLyRO
MEDTECH_DB_FLYWAY_USER=postgres
MEDTECH_DB_FLYWAY_PASSWORD=TGou6VDQfqFfnMLssAwzeNVtLyRO
MEDTECH_DB_SSLMODE=prefer

# ── Redis ────────────────────────────────────────────────────────────────────
MEDTECH_REDIS_HOST=redis
MEDTECH_REDIS_PORT=6379

# ── Cryptography ─────────────────────────────────────────────────────────────
MEDTECH_SECURITY_JWT_SECRET=a2252d3c9f2af4fe1e364b03afc258e8e427a6b9840705254dd7939671aa8e4b

# !! BACK THIS UP OFFLINE BEFORE FIRST BOOT !!
# AES-256-GCM key for PHI at rest (diagnoses, clinical notes, allergies).
# It is unrecoverable — lose it and the encrypted clinical data is gone.
MEDTECH_PHI_ENCRYPTION_KEY=oz9RUV7GX7R8C2e9uzn38E/AWX6LOzYZf1igekNPG6A=

# ── First-run admin ──────────────────────────────────────────────────────────
# Created only if the database has no ADMIN yet. Password must be >= 12 chars.
# Log in, change it, then delete these two lines and restart.
MEDTECH_BOOTSTRAP_ADMIN_EMAIL=CHANGE-ME@example.com
MEDTECH_BOOTSTRAP_ADMIN_PASSWORD=1eY8gMEov49c9myzg4vv

# ── Mail (transactional outbox -> SMTP) ──────────────────────────────────────
# Use a NEW Gmail app password, not the one from local development.
MEDTECH_MAIL_HOST=smtp.gmail.com
MEDTECH_MAIL_PORT=587
MEDTECH_MAIL_USERNAME=CHANGE-ME@gmail.com
MEDTECH_MAIL_PASSWORD=CHANGE-ME-app-password

# ── Security posture ─────────────────────────────────────────────────────────
# Secure cookies REQUIRE https. Leave commented so the prod default (true) wins.
#MEDTECH_SECURITY_COOKIE_SECURE=false
#NGINX_CONF=conf.d/medtech-dev.conf

MEDTECH_SECURITY_CORS_ALLOWEDORIGINS_0=https://CHANGE-ME.duckdns.org

# Per-IP auth budget. 10/60s is the secure default; the local demo box uses 100.
MEDTECH_SECURITY_RATELIMIT_CAPACITY=10
MEDTECH_SECURITY_RATELIMIT_WINDOWSECONDS=60
