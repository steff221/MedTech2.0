# Copy this file to .env and fill in the values before running docker compose.
# Never commit .env — it is listed in .gitignore.

# JWT signing secret — minimum 64 hex chars.
# Generate one with: openssl rand -hex 32
MEDTECH_SECURITY_JWT_SECRET=change-me-to-a-random-64-char-hex-secret

# Database
# POSTGRES_PASSWORD is the superuser (postgres) password — used by Docker initdb
# and Flyway migrations.  Keep it separate from MEDTECH_DB_PASSWORD.
POSTGRES_PASSWORD=change-me-superuser
# medtech_app has DML-only privileges (SELECT, INSERT, UPDATE, DELETE).
# The running application uses this credential — it cannot DROP or ALTER tables.
MEDTECH_DB_URL=jdbc:postgresql://postgres:5432/medtech
MEDTECH_DB_USER=medtech_app
MEDTECH_DB_PASSWORD=change-me-appuser
# SSL mode for the JDBC connection.
# Set to 'require' when Postgres runs on a separate host (RDS, Cloud SQL, VPS).
# Leave as 'prefer' for the compose stack where DB and backend share a private network.
MEDTECH_DB_SSLMODE=prefer
# Flyway runs DDL migrations as the superuser.
MEDTECH_DB_FLYWAY_USER=postgres
MEDTECH_DB_FLYWAY_PASSWORD=change-me-superuser

# Mail (Gmail app-password or SMTP relay credentials)
MEDTECH_MAIL_HOST=smtp.gmail.com
MEDTECH_MAIL_PORT=587
MEDTECH_MAIL_USERNAME=your-email@gmail.com
MEDTECH_MAIL_PASSWORD=your-app-password

# pgAdmin (dev profile only — never expose in production)
PGADMIN_EMAIL=admin@medtech.mk
PGADMIN_PASSWORD=change-me

# CORS — the public URL of the frontend
MEDTECH_SECURITY_CORS_ALLOWEDORIGINS_0=http://localhost:3000

# Redis
MEDTECH_REDIS_HOST=redis
MEDTECH_REDIS_PORT=6379

# ML scoring service — base-url is set in docker-compose (http://ml-service:8000).
# Set to false to disable ML calls; the backend falls back to rule-based logic.
MEDTECH_ML_ENABLED=true
