# Copy this file to .env and fill in the values before running docker compose.
# Never commit .env — it is listed in .gitignore.

# JWT signing secret — minimum 32 characters, random.
# Generate one with: openssl rand -hex 32
MEDTECH_SECURITY_JWT_SECRET=change-me-to-a-random-32-plus-char-secret

# PostgreSQL credentials (must match values in docker-compose.yml if you change them)
# POSTGRES_PASSWORD=MedTech123!@#
# MEDTECH_DB_PASSWORD=MedTech123!@#
